# ── Database (Supabase / any PostgreSQL) ──
DATABASE_URL="postgresql://postgres:password@db.xxxxx.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres"

# ── Auth ──
NEXTAUTH_SECRET="your-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ── Storage provider: "cloudinary" or "s3" ──
STORAGE_PROVIDER="cloudinary"
STORAGE_FOLDER="new-merch"

# ── Cloudinary (used when STORAGE_PROVIDER=cloudinary) ──
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ── AWS S3 (used when STORAGE_PROVIDER=s3) ──
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"
# AWS_REGION="eu-west-2"
# AWS_S3_BUCKET="your-bucket-name"

# ── Admin seed credentials ──
ADMIN_EMAIL="admin@yoursite.com"
ADMIN_PASSWORD="change-me-in-production"

# ── Site branding (client-safe, exposed to browser) ──
NEXT_PUBLIC_SITE_NAME="NewMerch"
NEXT_PUBLIC_SITE_TAGLINE="Professional print services for businesses."
NEXT_PUBLIC_STORAGE_FOLDER="new-merch"

# ── Contact info ──
NEXT_PUBLIC_CONTACT_PHONE="+44 (0) 123 456 7890"
NEXT_PUBLIC_CONTACT_EMAIL="hello@yoursite.com"
NEXT_PUBLIC_CONTACT_ADDRESS="123 Print Street, London, UK"

# ── Promo / marketing copy ──
NEXT_PUBLIC_DELIVERY_BANNER="Free UK delivery on orders over £50"
NEXT_PUBLIC_DISPATCH_NOTICE="Same day dispatch on orders before 12pm"
NEXT_PUBLIC_HERO_IMAGE="https://images.unsplash.com/photo-1588345921523-c2dcdb7f1dcd?w=1600&q=80"

# ── Locale & Currency ──
NEXT_PUBLIC_LOCALE="en-GB"
NEXT_PUBLIC_CURRENCY="GBP"
NEXT_PUBLIC_CART_STORAGE_KEY="new-merch-cart"
